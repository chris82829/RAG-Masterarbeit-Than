# Copy to .env and replace the placeholders. Never commit .env.
GOOGLE_API_KEY=replace-with-your-google-api-key
NUXT_SESSION_PASSWORD=replace-with-a-random-secret-at-least-32-characters-long

DB_NAME=jobby_db
DB_USER=jobby_admin
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
# Keep this URL consistent with the DB_* values; URL-encode special characters.
DATABASE_URL=postgresql://jobby_admin:replace-with-your-local-database-password@127.0.0.1:5432/jobby_db
